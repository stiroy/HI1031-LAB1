<web-app    xmlns="https://jakarta.ee/xml/ns/jakartaee"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee 
                    https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd"
            version="6.1">

    <welcome-file-list>
        <welcome-file>/WEB-INF/views/index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ============================================================ -->
    <!-- SECURITY CONSTRAINTS (URL Protection Rules)                  -->
    <!-- ============================================================ -->

    <!-- ADMIN Area -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Protected Admin Area</web-resource-name>
            <url-pattern>/app/status</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
        </auth-constraint>
    </security-constraint>

    <!-- EMPLOYEE Area -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Protected Employee Area</web-resource-name>
            <url-pattern>/app/employee/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>EMPLOYEE</role-name>
        </auth-constraint>
    </security-constraint>    

    <!-- CUSTOMER Area -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Protected Customer Area</web-resource-name>
            <url-pattern>/app/profile</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>CUSTOMER</role-name>
        </auth-constraint>
    </security-constraint>

    <!-- Everyone Area -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Protected user Area</web-resource-name>
            <url-pattern>/app/userProfile</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
            <role-name>EMPLOYEE</role-name>
            <role-name>CUSTOMER</role-name>
        </auth-constraint>
    </security-constraint>

    <login-config>
        <auth-method>FORM</auth-method>
        <realm-name>postgres</realm-name>
        <form-login-config>
            <form-login-page>/login.jsp</form-login-page>
            <form-error-page>/login-error.jsp</form-error-page>
        </form-login-config>
    </login-config>

    <!-- ============================================================ -->
    <!-- SECURITY ROLES (Application Role Declarations)               -->
    <!-- ============================================================ -->
    <security-role>
        <role-name>ADMIN</role-name>
    </security-role>
    <security-role>
        <role-name>EMPLOYEE</role-name>
    </security-role>
    <security-role>
        <role-name>CUSTOMER</role-name>
    </security-role>

    <!-- Make sure JNDI can see jdbc-->
    <resource-ref>
        <description>PostgreSQL User Database Connection</description>
        <res-ref-name>jdbc/postgres</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>
</web-app>
