<?xml version="1.0" encoding="UTF-8"?>
<Context sessionCookiePath="/">

    <!-- Database Connection Pool HakariCP -->
    <!-- Not sure if usable in program -->
     <!-- can name be anything? -->
    <Resource name="jdbc/postgres"
              auth="Container" 
              type="javax.sql.DataSource"
              maxTotal="10" 
              maxIdle="5" 
              maxWaitMillis="10000"
              username="sol" 
              password="terra" 
              driverClassName="org.postgresql.Driver"
              url="jdbc:postgresql://10.89.0.2:5432/milkyway"
              validationQuery="SELECT 1"
              testOnBorrow="true"/>

    <!-- Tomcat DataSource Realm Setup -->
    <!-- TODO: USER DB NEEDS CHANGE!!! -->
    <Realm className="org.apache.catalina.realm.DataSourceRealm"
            dataSourceName="jdbc/postgres"
            localDataSource="true"
            userTable="T_users" 
            userNameCol="username" 
            userCredCol="password_hash"
            userRoleTable="T_user_roles"
            roleNameCol="role_name">
           
        <!-- Enable Password Hashing (SSHA, SHA and MD5) -->
        <CredentialHandler className="org.apache.catalina.realm.MessageDigestCredentialHandler"
                           algorithm="SHA-256"
                           encoding="hex" />
    </Realm>

</Context>